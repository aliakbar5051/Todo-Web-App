# Copy this file to backend/.env and fill in your own credentials.
DATABASE_URL=postgresql+psycopg://todo_app:CHANGE_ME@localhost:5432/todo_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication Secrets
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-here-must-be-changed
ACCESS_TOKEN_EXPIRE_MINUTES=60
